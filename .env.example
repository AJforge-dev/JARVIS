# Jarvis AI Assistant - Environment Configuration

# Optional Cloud LLM API Keys (Can also be set directly in Jarvis Settings UI)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Local Ollama Server URL (Default: http://127.0.0.1:11434)
